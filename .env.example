# ─── Database ────────────────────────────────────────────────────────────────
# Local development and any host with a persistent disk. Relative paths resolve
# against prisma/.
DATABASE_URL="file:./dev.db"

# Production on a serverless host (Vercel has no writable disk). When
# TURSO_DATABASE_URL is set, the same Prisma client runs on the libSQL driver
# against a hosted Turso database instead — same schema, same migrations.
# Leave both unset for local development.
# TURSO_DATABASE_URL="libsql://<your-db>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token from: turso db tokens create <your-db>>"

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin of the deployment, no trailing slash. Canonical URLs, the
# sitemap, robots.txt and Open Graph tags are all generated from it, so it must
# be the real public origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
